<odoo>

	<record model="ir.ui.view" id="view_goja_wine_type_list">
        <field name="name">cw.wine.type.list</field>
        <field name="model">wine.type</field>
        <field name="type">tree</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record model="ir.actions.act_window" id="act_window_goja_wine_type">
        <field name="name">Wine Type</field>
        <field name="res_model">wine.type</field>
        <field name="view_mode">tree</field>
        <field name="view_id" eval="False"/>
        <field name="binding_model_id" eval="False"/>
        <field name="binding_type">action</field>
        <field name="binding_view_types">list</field>
        <field name="groups_id" eval="[(6, 0, [])]"/>
        <field name="search_view_id" ref=""/>
        <field name="domain" eval=""/>
        <field name="context">{}</field>
        <field name="filter" eval="False"/>
    </record>

</odoo>