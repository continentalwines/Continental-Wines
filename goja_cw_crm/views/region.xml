<odoo>

	<record model="ir.ui.view" id="cw_crm.view_goja_region_list">
        <field name="name">cw.region.list</field>
        <field name="model">goja.region</field>
        <field name="type">tree</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="country_id"/>
            </tree>
        </field>
    </record>

    <record model="ir.actions.act_window" id="cw_crm.act_window_goja_region">
        <field name="name">Region</field>
        <field name="res_model">goja.region</field>
        <field name="view_mode">tree</field>
        <field name="view_id" eval="False"/>
        <field name="binding_model_id" eval="False"/>
        <field name="binding_type">action</field>
        <field name="binding_view_types">list</field>
        <field name="groups_id" eval="[(6, 0, [])]"/>
        <field name="search_view_id" ref=""/>
        <field name="domain" eval=""/>
        <field name="context">{}</field>
        <field name="filter" eval="False"/>
    </record>

</odoo>