<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_view_search_commitment_date" model="ir.ui.view">
        <field name="name">sale.order.search.commitment.date</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <!-- Add commitment_date_only search field after the existing commitment_date filter -->
            <xpath expr="//search" position="inside">
                <field name="commitment_date_only" string="Delivery Date (Date)"/>
            </xpath>
        </field>
    </record>
</odoo>
