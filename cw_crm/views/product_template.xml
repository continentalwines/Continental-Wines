<odoo>

	<record model="ir.ui.view" id="view_product_template_product_form_inherit_crm_cw">
        <field name="name">product.template.product.form.inherit.crm.cw</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
			<xpath expr="//field[@name='barcode']" position="after">
                <field name="wine_type_id" options="{&quot;no_create&quot;:true,&quot;no_open&quot;:true}"/>
                <field name="country_id" options="{&quot;no_create&quot;:true,&quot;no_open&quot;:true}"/>
                <field name="region_id" options="{&quot;no_open&quot;:true}" domain="[[&quot;country_id&quot;,&quot;=&quot;,country_id]]"/>
            </xpath>
            <xpath expr="//field[@name='taxes_id']" position="after">
                <field name="price_by_bottle" string="Price (by bottle)"/>
                <field name="price_pouring" string="Price (pouring)"/>
            </xpath>
        </field>
    </record>

    <record model="ir.ui.view" id="view_product_template_search_stock_form_inherit_crm_cw">
        <field name="name">product.template.search.stock.form.inherit.crm.cw</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="stock.product_template_search_form_view_stock"/>
        <field name="arch" type="xml">
            <xpath expr="//search[1]/field[@name='categ_id']" position="after">
                <field name="wine_type_id"/>
                <field name="region_id"/>
                <field name="country_id"/>
            </xpath>
            <xpath expr="//search[1]/group[1]/filter[@name='categ_id']" position="after">
                <filter name="group_wine_type" string="Wine Type" context="{'group_by': 'wine_type_id'}"/>
                <filter name="group_region" string="Region" context="{'group_by': 'region_id'}"/>
                <filter name="group_country" string="Country" context="{'group_by': 'country_id'}"/>
            </xpath>
        </field>
    </record>

</odoo>
