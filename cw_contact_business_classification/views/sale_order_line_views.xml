    <!-- ── Search view: add Group By filters ── -->
    <record id="view_order_line_search_business_classification" model="ir.ui.view">
        <field name="name">sale.order.line.search.business_classification</field>
        <field name="model">sale.order.line</field>
        <field name="inherit_id" ref="sale.view_sales_order_line_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <group string="Business Classification" expand="0">
                    <filter
                        name="group_business_group"
                        string="Custom Group"
                        context="{'group_by': 'business_group'}"/>
                    <filter
                        name="group_business_channel"
                        string="Customer Channel"
                        context="{'group_by': 'business_channel'}"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
