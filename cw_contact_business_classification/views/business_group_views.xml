<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List view (inline editable) -->
    <record id="view_business_group_list" model="ir.ui.view">
        <field name="name">business.group.list</field>
        <field name="model">business.group</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- Form view -->
    <record id="view_business_group_form" model="ir.ui.view">
        <field name="name">business.group.form</field>
        <field name="model">business.group</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Window action -->
    <record id="action_business_group" model="ir.actions.act_window">
        <field name="name">Business Groups</field>
        <field name="res_model">business.group</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Configuration menu item under Contacts/Configuration, after Industries -->
    <menuitem
        id="menu_business_group"
        name="Business Groups"
        parent="contacts.menu_contacts_config"
        action="action_business_group"
        sequence="31"/>

</odoo>
