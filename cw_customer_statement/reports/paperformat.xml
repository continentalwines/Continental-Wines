<odoo>
    <record id="paperformat_customer_statement_report" model="report.paperformat">
        <field name="name">Paperformat for Customer Statement</field>
        <field name="default" eval="False"/>
        <field name="disable_shrinking" eval="True"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">64</field>
        <field name="margin_bottom">7</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_spacing">57</field>
        <field name="dpi">90</field>
    </record>
    <record id="paperformat_multi_customer_statement_report" model="report.paperformat">
        <field name="name">Paperformat for Multi Customer Statement</field>
        <field name="default" eval="False"/>
        <field name="disable_shrinking" eval="True"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">37</field>
        <field name="margin_bottom">7</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_spacing">30</field>
        <field name="dpi">90</field>
    </record>
</odoo>
